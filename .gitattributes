* text=auto

# VBA-редактор ожидает CRLF при импорте модулей и форм
*.bas text eol=crlf
*.frm text eol=crlf
*.frx binary

# Исходники и скрипты Windows
*.vb text eol=crlf
*.vbproj text eol=crlf
*.wxs text eol=crlf
*.wixproj text eol=crlf
*.props text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.svg text
*.bmp binary
*.rtf text eol=crlf
